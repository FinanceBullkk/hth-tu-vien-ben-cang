{
  "name": "hth-tu-vien-ben-cang",
  "version": "1.0.0",
  "private": true,
  "description": "HTH – Tu viện bên cảng: game web 3D nhiều người cho nhân viên HTH Logistics",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"node --watch server/index.js\" \"vite --config vite.config.js\"",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "loadtest": "node scripts/loadtest.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.187.0",
    "vite": "^8.3.6"
  }
}
